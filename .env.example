# =============================================================
# HYENA - Environment Variables
# Copy this to .env and fill in your actual values
# =============================================================

# ── API Keys (REQUIRED) ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key
GOOGLE_API_KEY=your-google-api-key

# ── Qdrant ────────────────────────────────────────────────────
# Local dev (make infra):   QDRANT_HOST=localhost
# Docker (make up):         QDRANT_HOST=qdrant  (set by docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────
# Local dev (make infra):   redis://localhost:6379/0
# Docker (make up):         redis://redis:6379/0  (set by docker-compose)
REDIS_URL=redis://localhost:6379/0

# ── App Settings ─────────────────────────────────────────────
DEBUG=true
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=1024
CHUNK_OVERLAP=200